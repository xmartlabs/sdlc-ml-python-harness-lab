FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:${PATH}"

WORKDIR /app

# git + docker CLI (client only): the SWE-bench Pro lane provisions workspaces
# from per-instance images and runs containerized validation — the worker
# shells out to `docker` against the socket mounted on the worker service only
# (docs/design-swe-bench-pro-lane.md). The api service never uses either.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends git curl ca-certificates; \
    arch="$(uname -m)"; \
    curl -fsSL "https://download.docker.com/linux/static/stable/${arch}/docker-27.5.1.tgz" \
      | tar -xz --strip-components=1 -C /usr/local/bin docker/docker; \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -; \
    apt-get install -y --no-install-recommends nodejs; \
    apt-get purge -y curl; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*

# Claude Code CLI as an LLM transport, not as a harness. When the lab has no
# OpenAI-compatible gateway configured, the in-process LLM callers that run in
# this image — the DeepEval judge, the SWE judge, the case summariser — reach a
# model by shelling out to `claude -p` with every tool disabled
# (src/harness_lab_app/llm_transport.py). A subscription token is then the only
# credential the whole lab needs. Auth comes from .env at runtime:
# CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY. See ADR-0043.
RUN npm install -g @anthropic-ai/claude-code && claude --version

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY README.md ./README.md
COPY src ./src
# --extra deepeval: trajectory metrics are part of the default scoring
# profile, and this image is where scoring runs.
RUN uv sync --no-dev --frozen --extra deepeval || uv sync --no-dev --extra deepeval

COPY . .

EXPOSE 8008

CMD ["uvicorn", "harness_lab_app.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8008", "--log-level", "info"]
