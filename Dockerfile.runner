# Runner image: executes exactly one benchmark run (scripts/bench_run.py) per
# container, launched by the Celery worker (one container per run, SWE-bench
# style). Includes the opencode CLI + conductor plugin that the CLI flow
# installs on the host via brew/npm (see the bench-run target in Makefile).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    # This container has no display, so say so rather than leaving every SDL
    # program to discover it. Without this a pygame app opens a window that
    # never closes, and the agent's shell waits on it forever.
    SDL_VIDEODRIVER=dummy \
    SDL_AUDIODRIVER=dummy \
    PATH="/opt/venv/bin:${PATH}"

# node 20 is required by opencode and the conductor plugin.
# libatomic1: pnpm honours a target repo's `packageManager` pin by fetching
# its standalone binary, which links against libatomic — absent from -slim.
# make: `make test` is the single most common validation command there is, and
# `readiness_service.infer_commands` proposes it for any repository with a
# `test:` target — against an image that did not have make, so the adopted gate
# would have exited 127. Just the binary, not build-essential.
# jq: the Shell ecosystem (ADR-0056) is only as runnable as the POSIX tooling
# this image ships. A shell repository's test harness reaches for jq the way a
# Python one reaches for pytest; without it every such suite dies with a
# configuration error that looks like the agent's fault. Installing it inside
# the *agent* container does not help — validation runs in a fresh one.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git jq make libatomic1 \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# pnpm and yarn, baked at build time. Target repositories declare their own
# setup commands (often inferred by the readiness step — a pnpm lockfile means
# `pnpm install`), and those commands execute inside THIS image, so the
# package managers have to already be here. Plain npm installs rather than
# corepack: corepack's on-demand download stalls without a visible error in
# this build environment, and a build step that hangs is worse than a boring
# one.
RUN npm install -g pnpm yarn \
    && pnpm --version && yarn --version

# Pin pnpm's store inside the repo mount but under an ignored path. Left to its
# default, pnpm walks up to the mount root (/app — the bind-mounted repository)
# and creates .pnpm-store/ there, flooding the host repo's git status with
# thousands of content-addressed files. data/pnpm-store keeps the hardlink
# benefit (same filesystem as the workspaces) AND survives across runs as a
# shared download cache.
ENV npm_config_store_dir=/app/data/pnpm-store

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY README.md ./README.md
COPY src ./src
RUN uv sync --no-dev --frozen || uv sync --no-dev

# pygame is not an app dependency; it is the runtime the build_from_scratch
# (Tetris) case needs for its headless objective validation (SDL dummy driver).
# jinja2 lives in the dev group (skills_sync renderer), but bench_run needs the
# renderer inside the container for per-run skill ablation (ADR-0011).
# pytest: graded cases ship their own test suite (ADR-0050, tetris-v2) and the
# validation container runs it against the agent's workspace.
RUN uv pip install --python /opt/venv/bin/python --no-cache pygame jinja2 pytest pytest-cov

# opencode CLI (host equivalent: brew install anomalyco/tap/opencode) and the
# conductor plugin the Makefile installs into ~/.config/opencode.
ARG OPENCODE_VERSION=latest
RUN npm install -g "opencode-ai@${OPENCODE_VERSION}" \
    && mkdir -p /root/.config/opencode \
    && npm install --prefix /root/.config/opencode opencode-conductor-plugin \
    && opencode --version

# Claude Code CLI so the `claude` harness runs inside the container too (whole
# lab in Docker). Auth comes from .env at runtime — CLAUDE_CODE_OAUTH_TOKEN
# (long-lived subscription token from `claude setup-token`) or ANTHROPIC_API_KEY.
# See docs/harness-adapters.md.
RUN npm install -g @anthropic-ai/claude-code && claude --version

# Fallback copy of the repo; at runtime the host repo is bind-mounted over /app
# so runs.yaml/workspace/data land on the host filesystem.
COPY . .

# The command is supplied per run by the executor, e.g.:
#   /opt/venv/bin/python scripts/bench_run.py --case tetris-v1 --run ... --score-mode manual
CMD ["/opt/venv/bin/python", "scripts/bench_run.py", "--help"]
