# Runner image: executes exactly one benchmark run (scripts/bench_run.py) per
# container, launched by the Celery worker (one container per run, SWE-bench
# style). Includes the opencode CLI + conductor plugin that the CLI flow
# installs on the host via brew/npm (see the bench-run target in Makefile).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    # This container has no display, so say so rather than leaving every SDL
    # program to discover it. Without this a pygame app opens a window that
    # never closes, and the agent's shell waits on it forever.
    SDL_VIDEODRIVER=dummy \
    SDL_AUDIODRIVER=dummy \
    PATH="/opt/venv/bin:${PATH}"

# node 20 is required by opencode and the conductor plugin.
# libatomic1: pnpm honours a target repo's `packageManager` pin by fetching
# its standalone binary, which links against libatomic — absent from -slim.
# make: `make test` is the single most common validation command there is, and
# `readiness_service.infer_commands` proposes it for any repository with a
# `test:` target — against an image that did not have make, so the adopted gate
# would have exited 127. Just the binary, not build-essential.
# jq: the Shell ecosystem (ADR-0056) is only as runnable as the POSIX tooling
# this image ships. A shell repository's test harness reaches for jq the way a
# Python one reaches for pytest; without it every such suite dies with a
# configuration error that looks like the agent's fault. Installing it inside
# the *agent* container does not help — validation runs in a fresh one.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git jq make libatomic1 \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# pnpm and yarn, baked at build time. Target repositories declare their own
# setup commands (often inferred by the readiness step — a pnpm lockfile means
# `pnpm install`), and those commands execute inside THIS image, so the
# package managers have to already be here. Plain npm installs rather than
# corepack: corepack's on-demand download stalls without a visible error in
# this build environment, and a build step that hangs is worse than a boring
# one.
RUN npm install -g pnpm yarn \
    && pnpm --version && yarn --version

# Pin pnpm's store inside the repo mount but under an ignored path. Left to its
# default, pnpm walks up to the mount root (/app — the bind-mounted repository)
# and creates .pnpm-store/ there, flooding the host repo's git status with
# thousands of content-addressed files. data/pnpm-store keeps the hardlink
# benefit (same filesystem as the workspaces) AND survives across runs as a
# shared download cache.
ENV npm_config_store_dir=/app/data/pnpm-store

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY README.md ./README.md
COPY src ./src
RUN uv sync --no-dev --frozen || uv sync --no-dev

# pygame is not an app dependency; it is the runtime the build_from_scratch
# (Tetris) case needs for its headless objective validation (SDL dummy driver).
# jinja2 lives in the dev group (skills_sync renderer), but bench_run needs the
# renderer inside the container for per-run skill ablation (ADR-0011).
# pytest: graded cases ship their own test suite (ADR-0050, tetris-v2) and the
# validation container runs it against the agent's workspace.
# httpx2: FastAPI's TestClient (starlette 1.3) needs it, so an agent can exercise
# an API in-process without a server or network (security-audit-v1, ADR-0087).
# Pinned to the lab's own lock (uv.lock) so the agent and the grader agree.
RUN uv pip install --python /opt/venv/bin/python --no-cache pygame jinja2 pytest pytest-cov \
        "httpx2==2.12.0"

# A real browser for frontend cases (ADR-0067, todo-web-v1): the graded suite
# drives the agent's page in headless Chromium through its accessible contract.
# Pinned, in its own layer so a Playwright bump does not rebuild the CLIs below.
# `--with-deps` pulls Chromium's system libraries (absent from -slim). Declaring
# BROWSER_AVAILABLE here makes the audit's capability table say so without a
# per-machine .env edit.
ARG PLAYWRIGHT_VERSION=1.56.0
ARG PYTEST_PLAYWRIGHT_VERSION=0.7.1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    BROWSER_AVAILABLE=1
RUN uv pip install --python /opt/venv/bin/python --no-cache \
        "playwright==${PLAYWRIGHT_VERSION}" "pytest-playwright==${PYTEST_PLAYWRIGHT_VERSION}" \
    && /opt/venv/bin/python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

# opencode CLI (host equivalent: brew install anomalyco/tap/opencode) and the
# conductor plugin the Makefile installs into ~/.config/opencode.
ARG OPENCODE_VERSION=latest
RUN npm install -g "opencode-ai@${OPENCODE_VERSION}" \
    && mkdir -p /root/.config/opencode \
    && npm install --prefix /root/.config/opencode opencode-conductor-plugin \
    && opencode --version

# Claude Code CLI so the `claude` harness runs inside the container too (whole
# lab in Docker). Auth comes from .env at runtime — CLAUDE_CODE_OAUTH_TOKEN
# (long-lived subscription token from `claude setup-token`) or ANTHROPIC_API_KEY.
# See docs/harness-adapters.md.
# Pinned: an unpinned install is cached by Docker, and stayed on 2.1.197 long
# after the API began refusing it for the 5.5 models (needs 2.1.280+). Fable 5.2
# needs 2.1.321+: 2.1.309 answers `unrecognized_model` before any request is
# sent. Bumping this ARG is what rebuilds the layer; the label lets the lab read
# the version without starting a container (native_models.MIN_CLAUDE_CLI_VERSION).
ARG CLAUDE_CODE_VERSION=2.1.325
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" && claude --version
LABEL claude-code.version="${CLAUDE_CODE_VERSION}"

# Codex CLI and Gemini CLI for the subscription-backed `codex` / `gemini`
# harnesses (ADR-0094). Pinned to the versions the lab verified its flags,
# event schemas and skill discovery against; native_models.
# MIN_NATIVE_CLI_VERSION refuses an image older than that. Auth is NOT baked
# in: each run mounts only its own provider's session directory
# (HARNESS_LAB_AUTH_DIR, `make auth-codex` / `make auth-gemini`) at
# /run/harness-auth/<provider>. Bump an ARG and rebuild to move a CLI.
ARG CODEX_VERSION=0.171.0
ARG GEMINI_CLI_VERSION=0.70.0
RUN npm install -g "@openai/codex@${CODEX_VERSION}" "@google/gemini-cli@${GEMINI_CLI_VERSION}" \
    && codex --version && gemini --version
LABEL codex.version="${CODEX_VERSION}" gemini-cli.version="${GEMINI_CLI_VERSION}"

# Antigravity CLI (`agy`) for the API-key `antigravity_cli` harness. Google's
# installer (https://antigravity.google/cli/install.sh) always fetches the
# latest build from a release manifest; this layer pins one release instead:
# the same versioned GCS tarball that manifest named for 1.5.14
# (…/manifests/linux_{amd64,arm64}.json, read 2026-11-22), verified against
# the manifest's sha512. The tarball holds one static binary, `antigravity`.
# No credential is baked in: a run gets the Gemini API key from the lab's
# store in its environment (api_key_auth). The self-updater is disabled so
# the instrument cannot change under an experiment. Bump the ARGs together
# with native_models.MIN_NATIVE_CLI_VERSION["antigravity_cli"].
ARG AGY_VERSION=1.5.14
ARG AGY_BUILD=1.5.14-5302690847260672
ARG AGY_SHA512_AMD64=83311d3f354567612dc16c1ae2ea9b503d6f6833aa4e138d39aa229da3f3bb99b0e4d7cca0bce4796b0060d6a51d8113eb7449ed5dc0e7900bf217107ea5bff9
ARG AGY_SHA512_ARM64=c9b29bba475f63a1a80161ae93ba72b221c7a586d9851e4d0061546704bab66d6b2760b25d716d191724fc7564f3246456ee151e28aa37af48dbcd72bdc6c463
ENV AGY_CLI_DISABLE_AUTO_UPDATE=true
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) dir=linux-x64; file=cli_linux_x64.tar.gz; sum="${AGY_SHA512_AMD64}" ;; \
      arm64) dir=linux-arm; file=cli_linux_arm64.tar.gz; sum="${AGY_SHA512_ARM64}" ;; \
      *) echo "agy: unsupported architecture $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    tmp="$(mktemp -d)"; \
    curl -fsSL -o "${tmp}/agy.tar.gz" \
      "https://storage.googleapis.com/antigravity-public/antigravity-cli/${AGY_BUILD}/${dir}/${file}"; \
    echo "${sum}  ${tmp}/agy.tar.gz" | sha512sum -c -; \
    tar -xzf "${tmp}/agy.tar.gz" -C "${tmp}" antigravity; \
    install -m 0755 "${tmp}/antigravity" /usr/local/bin/agy; \
    rm -rf "${tmp}"; \
    test "$(agy --version)" = "${AGY_VERSION}"
LABEL antigravity-cli.version="${AGY_VERSION}"

# Fallback copy of the repo; at runtime the host repo is bind-mounted over /app
# so runs.yaml/workspace/data land on the host filesystem.
COPY . .

# The command is supplied per run by the executor, e.g.:
#   /opt/venv/bin/python scripts/bench_run.py --case tetris-v1 --run ... --score-mode manual
CMD ["/opt/venv/bin/python", "scripts/bench_run.py", "--help"]
