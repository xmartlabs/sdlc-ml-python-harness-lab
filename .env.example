# =============================================================================
# OpenCode runtime configuration (copy to .env and edit).
#
# opencode.json reads these via {env:...} interpolation. opencode auto-loads a
# project .env; `make opencode` also loads it for you. Keep comments on their OWN
# lines — inline "VALUE  # comment" can leak into the value with some parsers.
# .env is gitignored: your IPs/keys never get committed.
# =============================================================================

# --- Active models (format: provider/model-id) -------------------------------
# IMPORTANT: the model id must EXACTLY match what your server serves. List them:
#   make opencode-doctor        (checks reachability)
#   opencode models             (lists every provider/model opencode sees)
#   curl $OLLAMA_BASE_URL/models | python3 -m json.tool      (Ollama ids)
#   curl $LMSTUDIO_BASE_URL/models | python3 -m json.tool    (LM Studio ids)
# RECOMMENDED (local_model_32k): route through the ai-gateway (LiteLLM). The build
# profile (output cap, temp 0.2, repetition penalty) is enforced at the gateway and
# every call is visible in Langfuse. See docs/local-model-runtime-config.md.
# Main tier — `build` agent (EXECUTION). Self-hosted, capped.
OPENCODE_MODEL=gateway/lmstudio-qwen3.6-35b-build
# Lightweight tier (titles, quick tasks):
OPENCODE_SMALL_MODEL=openai/qwen/qwen3.5-9b
# PLAN tier — `plan` agent (Tab to switch). Strong cloud for the small backlog only.
# Default GPT; Claude is last resort (Bedrock, ~2x the cost).
OPENCODE_MODEL_PLAN=gateway/gpt-5.5
# Alternatives:
#   Cheaper plan:                     OPENCODE_MODEL_PLAN=gateway/gpt-5  (or gateway/gpt-4o)
#   Last resort (pricey Bedrock):     OPENCODE_MODEL_PLAN=gateway/claude-sonnet-4.6
#   Build on the 27B local profile:   OPENCODE_MODEL=gateway/lmstudio-qwen3.6-27b-build
#   All-local plan (no cloud spend):  OPENCODE_MODEL_PLAN=gateway/lmstudio-qwen3.6-35b-build
#   No gateway (direct to servers):   OPENCODE_MODEL=lmstudio/qwen/qwen3-coder-30b
#                                     OPENCODE_MODEL_PLAN=opencode/nemotron-3-ultra-free

# --- AI Gateway (LiteLLM) — used by the `gateway/*` models above -------------
# baseURL must end in /v1. GATEWAY_TOKEN = your LITELLM_MASTER_KEY (or a virtual key).
GATEWAY_BASE_URL=http://localhost:4000/v1
GATEWAY_TOKEN=sk-local-change-me

# --- Lab LLM helpers (all optional) ------------------------------------------
# These are the lab's *in-process* LLM calls — audits, judges, summaries — as
# opposed to the harness runs above. They reach a model over one of two
# transports, in this fixed order (ADR-0043):
#   1. the gateway above, whenever GATEWAY_BASE_URL + GATEWAY_TOKEN are set;
#   2. the Claude Code CLI, when they are not but a Claude credential below is.
# Leave the model names commented out and each helper picks a sane default for
# whichever transport is active. Only set them if you want a specific model —
# and remember the names are transport-specific: `gpt-5.4-mini` is a gateway
# alias, `claude-sonnet-5` is what the CLI understands.
#
# Qualitative run audits (bench_audit.py). Needs judgment over long logs; a
# current mini-tier model is the cost sweet spot.
# AUDITOR_MODEL=gpt-5.4-mini
# Audit → GitHub-issue synthesis (lab_improve.py). Defaults to AUDITOR_MODEL.
# IMPROVE_MODEL=gpt-5.4-mini
# Case name/description polish on SWE-bench Pro import (case_summary.py).
# Trivial task — nano-tier is plenty. Defaults to AUDITOR_MODEL.
# CASE_SUMMARY_MODEL=gpt-5.4-nano
# DeepEval's trajectory judge (task_completion, step_efficiency). Defaults to
# AUDITOR_MODEL so one run is not judged by two independently configured
# models. Set it to `none` to keep the deterministic scores only.
# DEEPEVAL_MODEL=none

# --- Benchmark run management ------------------------------------------------
# LITELLM_MASTER_KEY is the admin key used by create_run.py to create per-run
# virtual keys with session_id + tags baked in. Without it, run attribution in
# Langfuse won't work (all traces land in the same bag with no session).
# Use the same value as LITELLM_MASTER_KEY in your ai-gateway config.
LITELLM_MASTER_KEY=sk-local-change-me

# --- Langfuse observability (optional; off by default) -----------------------
# What it buys you: one Langfuse SESSION per run, one TRACE per step, with the
# exact prompt sent, the harness output, the diff, the audit and the usage
# totals attached — so inspecting a case is one click instead of
# `cat data/runs/<id>/steps/step-3.log`.
#
# Master switch. false => zero HTTP calls and no code path taken. Turning it on
# with an empty key leaves it off (the reason shows up in Health).
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Separates this box's traces from CI or a teammate's in the same project.
LANGFUSE_TRACING_ENVIRONMENT=lab-local
# Project root in the Langfuse UI, used only to build the "View in Langfuse"
# link on a run. The host cannot be derived into it — the project id only
# exists in the UI URL. e.g. https://cloud.langfuse.com/project/abc123
LANGFUSE_PROJECT_URL=
# Session id prefix. Legacy CLI runs (runs.yaml) used the same prefix.
LANGFUSE_SESSION_PREFIX=bench-
# Export a run's traces as soon as it reaches a terminal state. false keeps the
# integration manual: `make langfuse-export RUN=<id>`.
LANGFUSE_AUTO_EXPORT=true
# Runs that finished before you turned this on are still exportable — every
# trace is rebuilt from data/runs/<id>/: `make langfuse-backfill`.

# --- Self-hosted endpoints (direct, no gateway) — used by ollama/* lmstudio/* -
# Also drive `make opencode-doctor` reachability checks.
#
# Both additionally power the "Direct (local)" source in the web run picker: the
# lab asks each host which models it serves and with what context window, so no
# gateway alias can rename them in transit (docs/local-model-runtime-config.md).
# Rules for both:
#   - keep the /v1 segment — completions go to the OpenAI-compatible endpoint;
#   - use the server's LAN address, not localhost, when the host is another
#     machine — and make that host listen on the network: "Serve on local
#     network" in LM Studio's Developer tab, OLLAMA_HOST=0.0.0.0 for Ollama.
# No opencode.json entry is needed: the routing overlay writes one per run.
#
# Ollama only: it serves OLLAMA_CONTEXT_LENGTH (default 4096) for every model,
# which is below this harness's ~13.7k-token system prompt. Set
# OLLAMA_CONTEXT_LENGTH=32768 on that server or no run can succeed there.
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Self-hosted convergence tuning (READ THIS if weak models don't converge) -
# These are the levers that decide whether a local model finishes a multi-step
# task or loops forever. See docs/task-sizing.md for the full reasoning.
#
# 1) CONTEXT LENGTH (the #1 cause of failure). A model served at the default
#    4k-8k window cannot hold governance + skills + the plan + history at once,
#    so it loses the task. opencode CANNOT fix a server pinned to 4k — raise it
#    AT THE SERVER:
#      - LM Studio: model load settings -> Context Length >= 16384 (32768 if VRAM allows).
#      - Ollama:    set num_ctx, e.g. `OLLAMA_CONTEXT_LENGTH=32768` or a Modelfile
#                   `PARAMETER num_ctx 32768`; confirm with `ollama show <model>`.
#
# 2) TEMPERATURE. Weak coder models converge better with low temperature. It is
#    set as a NUMBER on the `plan`/`build` agents in opencode.json (default 0.2);
#    it CANNOT be {env:...}-interpolated (that field requires a number, not a
#    string). Edit opencode.json directly to change it. Raise the `plan` agent
#    only if you want more divergent ideation.
#
# 3) SAME MODEL FOR PLAN AND BUILD (self-hosted). A strong planner (e.g. Nemotron
#    120B) writes steps that assume a strong executor; a weak local build model
#    then cannot chew them (the planner<->executor gap). For self-hosted, prefer
#    the SAME coder model for both, or a planner only slightly stronger:
#      OPENCODE_MODEL_PLAN=lmstudio/qwen/qwen3-coder-30b   # same as build
#    Then slice the task small (docs/task-sizing.md) instead of leaning on a big planner.

# --- Cloud providers ---------------------------------------------------------
# OpenCode Zen (default planner above) is built-in: run `opencode auth login` once.
# Its *-free models cost nothing; no key needed here.
#
# NVIDIA NIM is OPTIONAL — only if you switch OPENCODE_MODEL_PLAN to an nvidia/ model.
# Free key at https://build.nvidia.com -> "Get API Key". Leave empty otherwise.
NVIDIA_API_KEY=

# OpenAI is also built-in via `opencode auth login` (or OPENAI_API_KEY).
#   OPENCODE_MODEL=openai/gpt-4o
# OPENAI_API_KEY=sk-...

# --- Claude credentials (harness lane AND the fallback LLM transport) --------
# The `claude` harness runs the Claude Code CLI inside the runner container.
# The same credential also powers every in-process LLM call above when no
# gateway is configured, which is what makes a Claude subscription sufficient
# to run this lab end to end (ADR-0043). If you DO have a gateway, it keeps
# winning: adding a token here never changes which model judges your runs.
# Give it credentials here (flows into the container via .env) — use EITHER:
#   1. Your subscription (recommended): run `claude setup-token` on your host,
#      paste the long-lived token below. Uses your Claude plan.
# CLAUDE_CODE_OAUTH_TOKEN=
#   2. Or an Anthropic API key (pay-as-you-go):
# ANTHROPIC_API_KEY=sk-ant-...
# (codex-in-Docker is not wired yet — run codex via host mode, `make app-host`.)

# --- Web UI authentication (ADR-0015) ----------------------------------------
# Empty (the default) = open mode: no password, and anyone who can reach the port
# can drive the lab. Set both with `make set-password` — never by hand; the hash
# is PBKDF2 and the secret must be random. Read per request, so no restart.
# HARNESS_LAB_ADMIN_PASSWORD_HASH=
# HARNESS_LAB_SESSION_SECRET=
# HARNESS_LAB_SESSION_TTL_SECONDS=604800
# Set to true ONLY when TLS terminates in front of the app: over plain HTTP a
# Secure cookie is silently dropped and login appears to loop.
# HARNESS_LAB_SESSION_COOKIE_SECURE=false

# --- Always-on deployment (ADR-0019) -----------------------------------------
# Only read by `make app-up-prod` (nginx on :8080). Defaults to loopback: the UI
# is reachable from the server itself and nowhere else. Set 0.0.0.0 to reach it
# from the LAN — after `make set-password`, not before.
# HARNESS_LAB_BIND_ADDR=127.0.0.1

# --- Improvement-cycle issue targets -----------------------------------------
# GitHub slugs the improvement loop files issues against. Defaults point at the
# upstream repos this lab was built to measure; set these if you work from forks.
# Runtime defaults only: a stored proposal keeps the slug it was authored with,
# so retargeting never rewrites history.
# HARNESS_LAB_TEMPLATE_REPOSITORY=xmartlabs/sdlc-ml-python-base
# HARNESS_LAB_LAB_REPOSITORY=xmartlabs/sdlc-ml-python-harness-lab
# HARNESS_LAB_GUIDE_REPOSITORY=xmartlabs/sdlc-harness-engineering-guide

# --- Batch runs (ADR-0023) ---------------------------------------------------
# Ceiling on the cross-product of one POST /api/runs/batch. Four axes multiply
# into the hundreds from a single click and every unit is a Docker container, so
# raise this deliberately. The run form reads the value to size and block a batch.
# HARNESS_LAB_MAX_BATCH_RUNS=50

# --- Local repositories the lab may copy from (ADR-0045) ---------------------
# The audit onboarding opens with a folder picker: browse to a repository you
# already have and the lab copies it into data/checkouts/<target_id> and freezes
# it at that commit. The copy exists because a run container mounts only the lab
# root, so a repository anywhere else on the host is invisible to every run.
# The mount is read-only — the lab reads your clone and never writes to it.
# You only need this variable if your repositories are somewhere other than the
# directory the lab itself sits in — that is where the picker opens by default.
# Point it at ONE directory of repositories. Never a home directory: Docker
# Desktop injects filesystem events for the whole shared tree and a home
# directory carries enough of them to take the engine down.
# Requires `make app-down && make app-up` to take effect.
# HARNESS_LAB_LOCAL_SOURCES_DIR=/Users/you/code
