# Production frontend: build the SPA once, serve it from nginx.
#
# Unlike Dockerfile.frontend (Vite dev server, hot reload, source mounted from
# the host), this image is self-contained: nothing is bind-mounted, so the
# container survives the working tree changing underneath it. nginx also fronts
# the API on the same origin, which is what makes the session cookie and the
# Origin check in session_middleware.py trivially correct (ADR-0015).

FROM node:24-slim AS build

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./

# The SPA talks to /api on its own origin; nginx proxies it to the api service.
ENV VITE_API_BASE_URL=/api
RUN npm run build


FROM nginx:1.30-alpine AS serve

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html

EXPOSE 80

# 127.0.0.1, not localhost: `listen 80` binds IPv4 only, while `localhost`
# resolves to ::1 first inside the container, so wget got ECONNREFUSED and the
# container reported unhealthy forever regardless of nginx actually serving.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
