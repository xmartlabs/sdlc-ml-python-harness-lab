{
  "name": "agentic-harness-lab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:racing": "node --test src/gameplay/racing.test.mjs src/gameplay/ghost.test.mjs src/gameplay/racingBenchmark.test.mjs src/gameplay/comparisonGhost.test.mjs",
    "test:game-runtime": "node --test ../game-runtime/server.test.mjs",
    "build:game": "vite build --config vite.game.config.ts",
    "test:cooking": "node --test src/gameplay/cooking.test.mjs src/gameplay/cookingGhost.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
