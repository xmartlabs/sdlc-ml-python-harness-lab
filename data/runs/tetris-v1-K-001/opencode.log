+    if game.gravity_timer >= game.gravity_interval:
+        if game._can_place(game.piece_shape, game.piece_row + 1, game.piece_col):
+            game._drop_piece()
+        else:
+            game._lock_piece()
+        game.gravity_timer = 0
 
 game.render()
 pygame.display.flip()
 game.clock.tick(game.FPS)

