-"""Tetris — Milestone 1: empty pygame window at 300x600, 60fps, clean quit."""
+"""Tetris — Milestone 2: board grid rendered + static piece displayed."""
 
 import os
 import sys
 
 import pygame
 
 
+# Standard Tetris piece shapes (each is a list of (row, col) offsets from origin)
+PIECES = {
+    "I": [(0, 0), (0, 1), (0, 2), (0, 3)],
+    "O": [(0, 0), (0, 1), (1, 0), (1, 1)],
+    "T": [(0, 0), (0, 1), (0, 2), (1, 1)],
+    "S": [(0, 1), (0, 2), (1, 0), (1, 1)],
+    "Z": [(0, 0), (0, 1), (1, 1), (1, 2)],
+    "J": [(0, 0), (1, 0), (1, 1), (1, 2)],
+    "L": [(0, 2), (1, 0), (1, 1), (1, 2)],
+}
+
+PIECE_COLORS = {
+    "I": (0, 255, 255),
+    "O": (255, 255, 0),
+    "T": (128, 0, 128),
+    "S": (0, 255, 0),
+    "Z": (255, 0, 0),
+    "J": (0, 0, 255),
+    "L": (255, 165, 0),
+}
+
+
 class TetrisGame:
     """Minimal Tetris game loop."""
 
     WIDTH = 300
     HEIGHT = 600
     FPS = 60
+    COLS = 10
+    ROWS = 20
+    CELL = 30  # pixel size per cell
 
     def __init__(self):
         pygame.init()
         self.screen = pygame.display.set_mode((self.WIDTH, self.HEIGHT))
         pygame.display.set_caption("Tetris")
         self.clock = pygame.time.Clock()
         self.running = True
+        self.board = [[(0, 0, 0)] * self.COLS for _ in range(self.ROWS)]
+        # Spawn the first piece at top-center
+        self.piece_type = "I"
+        self.piece_shape = PIECES[self.piece_type]
+        self.piece_color = PIECE_COLORS[self.piece_type]
+        self.piece_row = 0
+        self.piece_col = 3
 
+    def _draw_cell(self, row, col, color):
+        """Draw a single filled cell with a thin border."""
+        x = col * self.CELL
+        y = row * self.CELL
+        pygame.draw.rect(self.screen, color, (x, y, self.CELL, self.CELL), 0)
+        border_color = tuple(max(c - 40, 0) for c in color)
+        pygame.draw.rect(self.screen, border_color, (x, y, self.CELL, self.CELL), 1)
+
+    def _draw_board(self):
+        """Draw the board background grid."""
+        for r in range(self.ROWS):
+            for c in range(self.COLS):
+                color = self.board[r][c]
+                if color != (0, 0, 0):
+                    self._draw_cell(r, c, color)
+
+    def _draw_grid_lines(self):
+        """Draw faint grid lines over the board area."""
+        grid_color = (30, 30, 30)
+        for r in range(self.ROWS + 1):
+            y = r * self.CELL
+            pygame.draw.line(self.screen, grid_color, (0, y), (self.WIDTH, y), 1)
+        for c in range(self.COLS + 1):
+            x = c * self.CELL
+            pygame.draw.line(self.screen, grid_color, (x, 0), (x, self.HEIGHT), 1)
+
+    def _draw_active_piece(self):
+        """Draw the currently active piece on the board."""
+        for dr, dc in self.piece_shape:
+            r = self.piece_row + dr
+            c = self.piece_col + dc
+            if 0 <= r < self.ROWS and 0 <= c < self.COLS:
+                self._draw_cell(r, c, self.piece_color)
+
+    def render(self):
+        """Draw board, grid lines, and active piece."""
+        self._draw_board()
+        self._draw_grid_lines()
+        self._draw_active_piece()
+
     def run(self):
         """Main game loop."""
         while self.running:
             for event in pygame.event.get():
                 if event.type == pygame.QUIT:
                     self.running = False
 
             self.screen.fill((0, 0, 0))
+            self.render()
             pygame.display.flip()
             self.clock.tick(self.FPS)
 
         pygame.quit()
