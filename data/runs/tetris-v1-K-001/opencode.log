+        if all(cell != (0, 0, 0) for cell in self.grid[row]):
+            lines_cleared += 1
+        else:
+            new_grid.append(self.grid[row])
+    while len(new_grid) < self.ROWS:
+        new_grid.insert(0, [(0, 0, 0)] * self.COLS)
+    self.grid = new_grid
