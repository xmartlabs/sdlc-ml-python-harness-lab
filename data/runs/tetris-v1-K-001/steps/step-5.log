 def _drop_piece(self):
     """Move the active piece down by one row."""
     self.piece_row += 1
 
+def _rotate_piece(self):
+    """Rotate the current piece 90° clockwise. Returns the new shape."""
+    return [(c, -r) for r, c in self.piece_shape]
+
+def _can_place(self, shape, row, col):
+    """Check if a piece at the given position is within board bounds."""
+    for dr, dc in shape:
+        r = row + dr
+        c = col + dc
+        if r < 0 or r >= self.ROWS or c < 0 or c >= self.COLS:
+            return False
+    return True
+
