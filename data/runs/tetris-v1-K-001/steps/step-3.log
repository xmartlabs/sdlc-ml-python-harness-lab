 import pygame
 import sys
+import random
 
 pygame.init()
 
 BLOCK_SIZE = 30
@@ -20,25 +21,129 @@
 BLACK = (0, 0, 0)
 WHITE = (255, 255, 255)
 GRID_COLOR = (40, 40, 40)
 
+TETROMINOES = {
+    'I': [(0,1),(1,1),(2,1),(3,1)],
+    'O': [(0,0),(1,0),(0,1),(1,1)],
+    'T': [(0,1),(1,0),(1,1),(2,1)],
+    'S': [(1,0),(2,0),(0,1),(1,1)],
+    'Z': [(0,0),(1,0),(1,1),(2,1)],
+    'J': [(0,0),(0,1),(1,1),(2,1)],
+    'L': [(2,0),(0,1),(1,1),(2,1)],
+}
 
