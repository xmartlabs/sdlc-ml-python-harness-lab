+    """Write the active piece to the board and spawn a new piece."""
+    for dr, dc in self.piece_shape:
+        r = self.piece_row + dr
+        c = self.piece_col + dc
+        if 0 <= r < self.ROWS and 0 <= c < self.COLS:
+            self.board[r][c] = self.piece_color
+    self.spawn_piece()
+
+def spawn_piece(self):
+    """Pick a random piece type and place it at top-center."""
+    self.piece_type = random.choice(list(PIECES.keys()))
+    self.piece_shape = PIECES[self.piece_type]
+    self.piece_color = PIECE_COLORS[self.piece_type]
+    self.piece_row = 0
+    self.piece_col = 3
+
 def _draw_cell(self, row, col, color):
