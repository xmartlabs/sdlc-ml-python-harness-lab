+    if game.piece_col + max_col < game.COLS:
+        game.piece_col += 1
+
 # Gravity timer: drop piece at fixed interval
 game.gravity_timer += 1
 if game.gravity_timer >= game.gravity_interval:
     game._drop_piece()

