+def _rotate_piece(self):
+    """Rotate the piece 90° clockwise with basic wall-kick against board edges."""
+    old_shape = self.piece_shape
+    rows = len(old_shape)
+    cols = len(old_shape[0])
+    new_shape = [
+        [old_shape[rows - 1 - r][c] for r in range(rows)]
+        for c in range(cols)
+    ]
+    shape_width = len(new_shape[0])
+    if self.piece_col >= 0 and self.piece_col + shape_width <= self.COLS:
+        self.piece_shape = new_shape
+        self.piece_orientation = (self.piece_orientation + 1) % 4
+        return
+    for kick in (1, -1, 2, -2):
+        new_col = self.piece_col + kick
+        if new_col >= 0 and new_col + shape_width <= self.COLS:
+            self.piece_shape = new_shape
+            self.piece_col = new_col
+            self.piece_orientation = (self.piece_orientation + 1) % 4
+            return
+
 def run(self):
