+def _tick_gravity(self, dt):
+    """Accumulate dt and move piece down when gravity interval is reached."""
+    self.gravity_acc += dt
+    while self.gravity_acc >= self.GRAVITY_INTERVAL:
+        self.piece_row -= 1
+        self.gravity_acc -= self.GRAVITY_INTERVAL
