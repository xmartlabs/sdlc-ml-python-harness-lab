@@ -11,16 +11,62 @@
 
     WIDTH = 300
     HEIGHT = 600
     FPS = 60
+    COLS = 10
+    ROWS = 20
+    CELL = WIDTH // COLS  # 30
 
+    # Colors
+    BG_COLOR = (15, 15, 15)
+    GRID_COLOR = (30, 30, 30)
+    PIECE_COLOR = (0, 200, 255)
+
+    # Board: None = empty, otherwise a color tuple
+    board = [[None] * COLS for _ in range(ROWS)]
+
+    # Static piece shape (T-tetromino) at spawn position
+    piece_shape = [
+        [0, 1, 0],
+        [1, 1, 1],
+    ]
+    piece_row = 18
+    piece_col = 4
+
     def __init__(self):
         pygame.init()
         self.screen = pygame.display.set_mode((self.WIDTH, self.HEIGHT))
         pygame.display.set_caption("Tetris")
         self.clock = pygame.time.Clock()
         self.running = True
 
+    def _draw_board(self):
+        """Draw the board grid lines."""
+        for r in range(self.ROWS + 1):
+            y = r * self.CELL
+            pygame.draw.line(
+                self.screen, self.GRID_COLOR,
+                (0, y), (self.WIDTH, y), 1,
+            )
+        for c in range(self.COLS + 1):
+            x = c * self.CELL
+            pygame.draw.line(
+                self.screen, self.GRID_COLOR,
+                (x, 0), (x, self.HEIGHT), 1,
+            )
+
+    def _draw_piece(self):
+        """Draw the static piece on the board."""
+        for dr, row in enumerate(self.piece_shape):
+            for dc, cell in enumerate(row):
+                if cell:
+                    x = (self.piece_col + dc) * self.CELL
+                    y = (self.piece_row + dr) * self.CELL
+                    pygame.draw.rect(
+                        self.screen, self.PIECE_COLOR,
+                        (x + 1, y + 1, self.CELL - 2, self.CELL - 2),
+                    )
+
     def run(self):
         """Main game loop."""
         while self.running:
             dt = self.clock.tick(self.FPS) / 1000.0
