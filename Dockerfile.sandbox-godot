# Sandbox image for 3D game cases (ADR-0078): the shared sandbox (ttyd, Xvfb,
# fluxbox, noVNC) plus the Godot engine, so a person can *play* the game a run
# built. A case opts in with `sandbox_image: harness-lab-sandbox-godot:latest`;
# the "Play" tab then opens a desktop that starts the case's `play_command`.
#
# The desktop renders through Mesa llvmpipe on the CPU: fine to play a board
# game or a light 3D scene, slow for heavy ones. That is the honest ceiling of
# a GPU-less sandbox, not a property of the game.
ARG BASE_IMAGE=harness-lab-sandbox:latest
FROM ${BASE_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        unzip \
        libgl1 libgl1-mesa-dri libglx-mesa0 libegl1 \
        libxcursor1 libxinerama1 libxrandr2 libxi6 libxkbcommon0 \
        libfontconfig1 libasound2 libpulse0 libdbus-1-3 libudev1 \
    && rm -rf /var/lib/apt/lists/*

# The same engine as Dockerfile.runner-godot: what you play is what was graded.
ARG GODOT_VERSION=4.7.2-stable
RUN arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) g=x86_64 ;; arm64) g=arm64 ;; *) echo "unsupported arch $arch" >&2; exit 1 ;; esac; \
    curl -fsSL -o /tmp/godot.zip \
        "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/Godot_v${GODOT_VERSION}_linux.${g}.zip" \
    && unzip -q /tmp/godot.zip -d /opt/godot \
    && rm /tmp/godot.zip \
    && ln -s "/opt/godot/Godot_v${GODOT_VERSION}_linux.${g}" /usr/local/bin/godot \
    && godot --headless --version
LABEL godot.version="${GODOT_VERSION}"
